# Copy to .env.local and fill in the values.
# These are server-side only — never prefixed with VITE_, so they are not
# shipped to the browser.

# The only key you need. Get one at https://aistudio.google.com/apikey
# It runs everything: the text criteria and the audio pass (transcription plus
# the Pronunciation criterion, which DeepSeek cannot do at all).
#
# AI Studio now issues "AQ.Ab..." auth keys; the older "AIza..." standard keys
# are being retired during 2026. Both work here, but new keys will be "AQ.".
GEMINI_API_KEY=AQ.Ab...

# Optional. Any audio-capable Gemini model.
# GEMINI_MODEL=gemini-3.6-flash

# Optional. Key from https://platform.deepseek.com
# When set, the text criteria move to DeepSeek — the grading prompt was tuned
# against it. Audio always stays on Gemini. Leave it out to run on one free key.
# DEEPSEEK_API_KEY=sk-...

# Optional. deepseek-v4-pro (default) is stronger at grading;
# deepseek-v4-flash is roughly 3x cheaper and faster.
# DEEPSEEK_MODEL=deepseek-v4-pro

# Optional. low | high | max (default high). DeepSeek only.
# DEEPSEEK_REASONING_EFFORT=high

# Optional. Analyses allowed per IP per hour (default 10).
# RATE_LIMIT_PER_HOUR=10

# Optional. Audio assessments allowed per IP per hour (default 20).
# SPEECH_RATE_LIMIT_PER_HOUR=20

# Optional — accounts and cross-device history. Without these the app still
# works, it just keeps history in this browser and hides the sign-in button.
# From your Supabase project: Settings -> API.
# The anon key is public by design; every table is protected by Row Level
# Security (see supabase/schema.sql).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...
